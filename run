#!/usr/bin/env bash
set -euo pipefail

# Code Ocean 运行入口：
# 从公开的三张精简数据表开始，重新执行现代数据切分、插补、SMOTE、
# 归一化、GeoDAN 训练，并使用训练得到的权重完成太古代预测。

CODE_ROOT="/code"
DATA_ASSET_ROOT="/data/basalt_geochemistry_dataset"
WORK_DATA_ROOT="/scratch/basalt_tectonic_discrimination/data"
RESULTS_ROOT="/results"

mkdir -p "$WORK_DATA_ROOT/basalt_geochemistry_dataset"
mkdir -p "$WORK_DATA_ROOT/03_combined"
mkdir -p "$RESULTS_ROOT"

# 数据资产只读，因此复制到可写的 scratch 目录后再运行全部阶段。
cp "$DATA_ASSET_ROOT/modern_basalt_geochemistry.csv" \
   "$WORK_DATA_ROOT/basalt_geochemistry_dataset/modern_basalt_geochemistry.csv"
cp "$DATA_ASSET_ROOT/archean_basalt_geochemistry.csv" \
   "$WORK_DATA_ROOT/basalt_geochemistry_dataset/archean_basalt_geochemistry.csv"
cp "$DATA_ASSET_ROOT/archean_basalt_geodan_predictions.csv" \
   "$WORK_DATA_ROOT/basalt_geochemistry_dataset/archean_basalt_geodan_predictions.csv"

# 现代公开表就是训练/测试切分阶段的合并表输入。
cp "$DATA_ASSET_ROOT/modern_basalt_geochemistry.csv" \
   "$WORK_DATA_ROOT/03_combined/01_basalt_number_year.csv"

export BASALT_DATA_DIR="$WORK_DATA_ROOT"
export GEODAN_PREDICTION_ONLY="1"

python "$CODE_ROOT/01_preprocessing/split_train_test.py"
python "$CODE_ROOT/02_imputation/imputation_train_predict.py"
python "$CODE_ROOT/03_normalization/normalize_major_elements.py"
python "$CODE_ROOT/03_normalization/selective_smote.py"
python "$CODE_ROOT/03_normalization/normalize.py"
python "$CODE_ROOT/04_model/ablation_v4_vit_transformer.py"
python "$CODE_ROOT/06_archean_application/archean_vit_transformer_dualstream_predict_analysis.py"

# 只保存复现所需的中间表、模型权重和太古代预测结果。
cp -r "$WORK_DATA_ROOT/04_split" "$RESULTS_ROOT/04_split"
cp -r "$WORK_DATA_ROOT/05_imputed" "$RESULTS_ROOT/05_imputed"
cp -r "$WORK_DATA_ROOT/06_normalized" "$RESULTS_ROOT/06_normalized"
cp -r "$WORK_DATA_ROOT/models" "$RESULTS_ROOT/models"
cp -r "$WORK_DATA_ROOT/archean" "$RESULTS_ROOT/archean"

echo "Code Ocean reproduction completed."
